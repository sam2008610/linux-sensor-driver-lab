# 本專案在 arm64 defconfig 之上額外開啟的 kernel 選項。
# build-kernel.sh 會把這個片段合併進 .config，並檢查每一項是否真的生效。
# 每一項的說明與查證來源見 docs/lessons/stage-0-env.md。

# 讓 `uname -r` 看得出是本專案的 kernel
CONFIG_LOCALVERSION="-lab"

# --- module ---
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# --- 開機：initramfs、/dev 自動建立 ---
CONFIG_BLK_DEV_INITRD=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- 和 host 共享資料夾（virtio + 9p） ---
CONFIG_VIRTIO_PCI=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y

# --- 除錯基本工具 ---
CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_GDB_SCRIPTS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_DYNAMIC_DEBUG=y
CONFIG_MAGIC_SYSRQ=y
# BTF 是給 eBPF 用的，本專案用不到，關掉可以省編譯時間
# CONFIG_DEBUG_INFO_BTF is not set

# --- 鎖的除錯 ---
CONFIG_PROVE_LOCKING=y
CONFIG_DEBUG_ATOMIC_SLEEP=y
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_DETECT_HUNG_TASK=y

# --- 記憶體錯誤偵測 ---
CONFIG_KASAN=y
CONFIG_KASAN_GENERIC=y

# --- 模擬 GPIO：階段 3 的中斷來源 ---
CONFIG_GPIOLIB=y
CONFIG_CONFIGFS_FS=y
CONFIG_GPIO_SIM=y

# --- IIO 核心：out-of-tree module 不能 select，所以必須編進 kernel ---
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_KFIFO_BUF=y
CONFIG_IIO_TRIGGER=y
CONFIG_IIO_TRIGGERED_BUFFER=y
CONFIG_IIO_SYSFS_TRIGGER=y
